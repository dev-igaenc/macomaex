
#### Security Policy BEGIN #####
<IfModule mod_rewrite.c>
RewriteEngine On

# Block common sensitive files and metadata directories from web access.
RewriteCond %{THE_REQUEST} "(?:/|%2f)(?:\.env|\.git|\.svn|\.hg|\.aws)(?:[/?#\s]|%2f)" [NC,OR]
RewriteCond %{REQUEST_URI} "(^|/)(\.env[^/]*|\.git|\.svn|\.hg|\.aws)(/|$)" [NC,OR]
RewriteCond %{REQUEST_URI} "(^|/)(composer\.(json|lock)|package-lock\.json|package\.json|yarn\.lock|pnpm-lock\.yaml)(\?.*)?$" [NC,OR]
RewriteCond %{REQUEST_URI} "(^|/)(\.htaccess|\.htpasswd|web\.config)(\?.*)?$" [NC,OR]
RewriteCond %{REQUEST_URI} "(^|/)(backup|dump|database|db|sql|config|settings|credentials)[^/]*\.(sql|sqlite|db|bak|backup|old|orig|save|zip|tar|tgz|gz|7z|rar)(\?.*)?$" [NC]
RewriteRule ^ - [F,L]
</IfModule>
#### Security Policy END #####

#### 그누보드5 rewrite BEGIN #####
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Canonical home URL: hide /index.php while preserving any query string.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L,NE]

# User-facing routes. Keep existing PHP endpoints available for compatibility.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^about/?$ ko/greeting.php [QSA,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} (?:^|&)category=([^&]+) [NC]
RewriteRule ^companies/?$ ko/matching_list.php?cat=%1 [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^companies/?$ ko/matching_list.php [QSA,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+) [NC]
RewriteRule ^companies/detail/?$ ko/company_detail.php?cd=%1 [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^companies/detail/?$ ko/company_detail.php [QSA,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^recommendations/?$ ko/company_list_ai.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^recommendations/demo/?$ ko/company_list_ai_demo.php?entry=matching_ai_demo [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} (?:^|&)id=([^&]+) [NC]
RewriteRule ^recommendations/detail/?$ ko/company_detail_ai.php?cd=%1 [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^recommendations/detail/?$ ko/company_detail_ai.php [QSA,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^plans/?$ ko/plan.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^account/credits/?$ ko/my_plan.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^account/trades/?$ ko/my_matching.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^account/company/?$ ko/my_company.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^account/profile/?$ ko/my_info.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^account/inquiries/?$ ko/my_inquiries.php [QSA,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^promotions/?$ ko/promotion.php [QSA,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^signup/?$ bbs/register.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^content/([0-9a-zA-Z_]+)$  bbs/content.php?co_id=$1&rewrite=1  [QSA,L]
RewriteRule ^content/([^/]+)/$  bbs/content.php?co_seo_title=$1&rewrite=1      [QSA,L]
RewriteRule ^rss/([0-9a-zA-Z_]+)$  bbs/rss.php?bo_table=$1        [QSA,L]
RewriteRule ^([0-9a-zA-Z_]+)$  bbs/board.php?bo_table=$1&rewrite=1      [QSA,L]
RewriteRule ^([0-9a-zA-Z_]+)/([^/]+)/$ bbs/board.php?bo_table=$1&wr_seo_title=$2&rewrite=1      [QSA,L]
RewriteRule ^([0-9a-zA-Z_]+)/write$  bbs/write.php?bo_table=$1&rewrite=1    [QSA,L]
RewriteRule ^([0-9a-zA-Z_]+)/([0-9]+)$  bbs/board.php?bo_table=$1&wr_id=$2&rewrite=1  [QSA,L]
</IfModule>
#### 그누보드5 rewrite END #####

#### Cache Policy BEGIN #####
<IfModule mod_expires.c>
  ExpiresActive On

  # Static assets: long cache (versioned by ?ver=...)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/octet-stream "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Static assets
  <FilesMatch "\.(css|js|mjs|gif|png|jpe?g|svg|webp|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Dynamic documents
  <FilesMatch "\.(php|html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
#### Cache Policy END #####
